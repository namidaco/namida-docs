{
  "title": "Namida",
  "url": "https://namidaco.github.io/namida_docs",
  "src": "docs",
  "out": "site",
  "engine": "js",
  "logo": {
    "light": "assets/images/namida_icon.png",
    "dark": "assets/images/namida_icon.png",
    "href": "/",
    "alt": "Namida Logo",
    "height": "32px"
  },
  "favicon": "assets/favicon.ico",
  "layout": {
    "spa": true,
    "header": {
      "enabled": true
    },
    "sidebar": {
      "collapsible": true,
      "defaultCollapsed": false
    },
    "optionsMenu": {
      "position": "sidebar-top",
      "components": {
        "search": true,
        "themeSwitch": true
      }
    },
    "footer": {
      "style": "minimal",
      "content": "©namidaco",
      "branding": false
    }
  },
  "versions": {
    "current": "v6.5.0",
    "all": [{ "id": "v6.5.0", "dir": "docs", "label": "v6.5.0" }]
  },
  "theme": {
    "name": "summer",
    "template": "summer",
    "appearance": "system",
    "codeHighlight": true,
    "copyWidgets": {
      "enabled": false,
      "raw": false,
      "context": false
